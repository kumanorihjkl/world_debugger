# Never commit real keys. Copy to backend/.env for local runs.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
RULE_MODEL=muse-spark-1.3
SEGMENTATION_MODEL=sam-3.1
# true = offline fixture mode (no cost). Demo/production must use false + real key.
MOCK_META_API=true
# JSON file for rule persistence (survives backend restarts). Default: backend/rules.json
RULES_FILE=
REQUEST_TIMEOUT_S=20
MAX_RETRIES=2
SAM_CACHE_TTL_S=5
